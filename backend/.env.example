# FruitTreeScanner Backend Environment Variables
# Copy this file to .env and fill in the values

# Application
DEBUG=true
APP_NAME="FruitTreeScanner API"
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fruittreescanner
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_NAME=fruittreescanner:jobs

# S3/R2 Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=fruittreescanner
S3_REGION=us-east-1

# Processing
MAX_UPLOAD_SIZE=524288000
ALLOWED_EXTENSIONS=["ply", "pcd", "xyz"]

# CORS (comma-separated list of origins)
CORS_ORIGINS=["*"]

# Go Worker
GO_WORKER_URL=http://localhost:8081

# JWT Settings
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
